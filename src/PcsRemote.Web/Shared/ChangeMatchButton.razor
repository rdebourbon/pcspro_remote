@using Microsoft.Extensions.Logging
@using PcsRemote.Core
@implements IDisposable
@inject IPcsProAutomationService AutomationService
@inject IManualModeService ManualModeService
@inject IOperationCoordinatorService CoordinatorService
@inject IScoreboardService ScoreboardService
@inject IConfirmDialogService ConfirmDialogService
@inject NotificationService NotificationService
@inject ILogger<ChangeMatchButton> Logger

<button class="change-match-button"
        title="@(_operationInProgress ? "Automation in progress\u2026" : "")"
        disabled="@(!IsEnabled)"
        @onclick="OnChangeMatchClickedAsync">
    Change Match
</button>

@code {
    private PcsProState _currentState;
    private bool _operationInProgress;
    private bool _manualModeActive;
    private bool _disposed;

    private bool IsEnabled => _currentState == PcsProState.MatchLoaded && !_operationInProgress && !_manualModeActive;

    protected override void OnInitialized()
    {
        // Subscribe before snapshot to narrow the race window (established project pattern).
        AutomationService.StateChanged += OnStateChanged;
        ManualModeService.ManualModeChanged += OnManualModeChanged;
        CoordinatorService.OperationInProgressChanged += OnOperationInProgressChanged;
        _currentState = AutomationService.CurrentState;
        _manualModeActive = ManualModeService.IsManualModeActive;
        _operationInProgress = CoordinatorService.IsOperationInProgress;
    }

    private async Task OnChangeMatchClickedAsync()
    {
        if (_operationInProgress)
            return;

        if (ManualModeService.IsManualModeActive)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Automation is paused — disable manual mode before issuing commands");
            return;
        }

        var confirmed = await ConfirmDialogService.ConfirmAsync(
            "Load a different match? PCS Pro will close and reopen to the match selection screen.",
            "Change Match");

        if (confirmed != true)
            return;

        bool acquired = false;
        try
        {
            // BeginOperation() returns false if another browser already owns the lock (no-op).
            // Only proceed — and only release — when this call wins the CAS.
            acquired = CoordinatorService.BeginOperation();
            if (!acquired)
                return;
            ScoreboardService.ClearCache();
            await AutomationService.ChangeMatchAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Change match operation failed");
            NotificationService.Notify(NotificationSeverity.Error, "Change match failed");
        }
        finally
        {
            if (acquired)
                CoordinatorService.MarkComplete();
        }
    }

    private async void OnOperationInProgressChanged(object? sender, bool isInProgress)
    {
        _operationInProgress = isInProgress;
        if (!_disposed)
        {
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { }
        }
    }

    private async void OnStateChanged(object? sender, PcsProState newState)
    {
        _currentState = newState;
        if (!_disposed)
        {
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { }
        }
    }

    private async void OnManualModeChanged(object? sender, bool isActive)
    {
        _manualModeActive = isActive;
        if (!_disposed)
        {
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        AutomationService.StateChanged -= OnStateChanged;
        ManualModeService.ManualModeChanged -= OnManualModeChanged;
        CoordinatorService.OperationInProgressChanged -= OnOperationInProgressChanged;
    }
}
