@using Microsoft.Extensions.Logging
@using PcsRemote.Core
@implements IDisposable
@inject IScoreboardService ScoreboardService
@inject IPcsProAutomationService AutomationService
@inject IManualModeService ManualModeService
@inject NotificationService NotificationService
@inject ILogger<RefreshScoreboardButton> Logger

<button class="refresh-scoreboard-button"
        disabled="@(!IsEnabled)"
        @onclick="OnRefreshClickedAsync">
    Refresh Scoreboard
</button>

@code {
    private PcsProState _currentState;
    private bool _refreshInProgress;
    private bool _manualModeActive;
    private bool _disposed;

    private bool IsEnabled => _currentState == PcsProState.MatchLoaded && !_refreshInProgress && !_manualModeActive;

    protected override Task OnInitializedAsync()
    {
        // Subscribe before snapshot to narrow the race window (established project pattern).
        ScoreboardService.RefreshCompleted += OnRefreshCompleted;
        AutomationService.StateChanged += OnStateChanged;
        ManualModeService.ManualModeChanged += OnManualModeChanged;

        _currentState = AutomationService.CurrentState;
        _manualModeActive = ManualModeService.IsManualModeActive;

        return Task.CompletedTask;
    }

    private async Task OnRefreshClickedAsync()
    {
        if (ManualModeService.IsManualModeActive)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Automation is paused — disable manual mode before issuing commands");
            return;
        }

        _refreshInProgress = true;
        StateHasChanged();

        try
        {
            await ScoreboardService.ForceRefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Forced scoreboard refresh failed");
            NotificationService.Notify(NotificationSeverity.Error, "Refresh failed");
        }
        finally
        {
            _refreshInProgress = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async void OnRefreshCompleted(object? sender, EventArgs e)
    {
        if (!_disposed)
        {
            await InvokeAsync(() =>
            {
                NotificationService.Notify(NotificationSeverity.Success, "Scoreboard refreshed");
            });
        }
    }

    private async void OnStateChanged(object? sender, PcsProState newState)
    {
        _currentState = newState;
        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void OnManualModeChanged(object? sender, bool isActive)
    {
        _manualModeActive = isActive;
        if (!_disposed)
        {
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        ScoreboardService.RefreshCompleted -= OnRefreshCompleted;
        AutomationService.StateChanged -= OnStateChanged;
        ManualModeService.ManualModeChanged -= OnManualModeChanged;
    }
}
