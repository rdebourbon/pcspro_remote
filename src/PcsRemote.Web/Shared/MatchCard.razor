@using PcsRemote.Core
@using System.Globalization

@if (IsInteractive)
{
    <div class="match-card" @onclick="HandleClick">
        <span class="match-card-home">@Match.HomeTeam</span>
        <span class="match-card-away">@Match.AwayTeam</span>
        <span class="match-card-type">@Match.MatchType</span>
        <span class="match-card-date">@Match.MatchDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</span>
    </div>
}
else
{
    <div class="match-card match-card--disabled">
        <span class="match-card-home">@Match.HomeTeam</span>
        <span class="match-card-away">@Match.AwayTeam</span>
        <span class="match-card-type">@Match.MatchType</span>
        <span class="match-card-date">@Match.MatchDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public MatchInfo Match { get; set; } = default!;
    [Parameter] public bool IsInteractive { get; set; }
    [Parameter] public EventCallback<MatchInfo> OnSelected { get; set; }

    private Task HandleClick() => OnSelected.InvokeAsync(Match);
}
