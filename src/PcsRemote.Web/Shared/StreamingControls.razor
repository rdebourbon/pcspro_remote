@using PcsRemote.Core
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IYouTubeLiveStreamService StreamService
@inject IOperationCoordinatorService CoordinatorService
@inject IManualModeService ManualModeService
@inject IConfirmDialogService ConfirmDialogService
@inject ILogger<StreamingControls> Logger

<div class="streaming-controls">
    @if (_availability != YouTubeAvailability.Ready)
    {
        <div class="streaming-controls__auth-banner streaming-controls__auth-banner--@_availability.ToString().ToLowerInvariant()">
            ⚠ @GetAvailabilityMessage()
        </div>
    }

    <div class="streaming-controls__header">
        <span class="streaming-controls__badge streaming-controls__badge--@_currentStatus.ToString().ToLowerInvariant()">
            @GetStatusText()
        </span>
        <span class="streaming-controls__title">Live Stream</span>
    </div>

    <div class="streaming-controls__actions">
        <button class="streaming-controls__btn streaming-controls__btn--start"
                disabled="@(!IsStartEnabled)"
                @onclick="OnStartClickedAsync">
            ▶ Start Stream
        </button>

        @if (_currentStatus == LiveStreamStatus.Starting)
        {
            <button class="streaming-controls__btn streaming-controls__btn--cancel"
                    @onclick="OnCancelClicked">
                Cancel
            </button>
        }

        <button class="streaming-controls__btn streaming-controls__btn--stop"
                disabled="@(!IsStopEnabled)"
                @onclick="OnStopClickedAsync">
            ⏹ Stop Stream
        </button>
    </div>

    @if (_currentStatus == LiveStreamStatus.Live && _currentBroadcast is not null)
    {
        <div class="streaming-controls__watch">
            <a href="@_currentBroadcast.WatchUrl" target="_blank" rel="noopener noreferrer"
               class="streaming-controls__watch-link">
                Watch on YouTube ↗
            </a>
        </div>
    }

    @if (_currentStatus == LiveStreamStatus.Error)
    {
        <div class="streaming-controls__error">
            <span class="streaming-controls__error-message">@_errorMessage</span>
            <button class="streaming-controls__btn streaming-controls__btn--dismiss"
                    @onclick="OnDismissClickedAsync">
                Dismiss
            </button>
        </div>
    }
</div>

@code {
    private LiveStreamStatus _currentStatus;
    private LiveBroadcastInfo? _currentBroadcast;
    private string? _errorMessage;
    private bool _operationInProgress;
    private bool _manualModeActive;
    private YouTubeAvailability _availability;
    private bool _disposed;
    private CancellationTokenSource? _startCts;

    private bool IsStartEnabled => _currentStatus == LiveStreamStatus.Idle && !_operationInProgress && !_manualModeActive && _availability == YouTubeAvailability.Ready;
    private bool IsStopEnabled => _currentStatus == LiveStreamStatus.Live && !_operationInProgress && !_manualModeActive;

    protected override void OnInitialized()
    {
        StreamService.StatusChanged += OnStatusChanged;
        StreamService.AuthStatusChanged += OnAuthStatusChanged;
        CoordinatorService.OperationInProgressChanged += OnOperationInProgressChanged;
        ManualModeService.ManualModeChanged += OnManualModeChanged;
        _currentStatus = StreamService.CurrentStatus;
        _currentBroadcast = StreamService.CurrentBroadcast;
        _operationInProgress = CoordinatorService.IsOperationInProgress;
        _manualModeActive = ManualModeService.IsManualModeActive;
        _availability = StreamService.Availability;
    }

    private async void OnStatusChanged(object? sender, StreamStateSnapshot snapshot)
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(() =>
            {
                _currentStatus = snapshot.Status;
                _currentBroadcast = snapshot.CurrentBroadcast;
                _errorMessage = snapshot.ErrorMessage;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async void OnAuthStatusChanged(object? sender, YouTubeAuthStatusSnapshot snapshot)
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(() =>
            {
                _availability = snapshot.Availability;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async void OnOperationInProgressChanged(object? sender, bool isInProgress)
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(() =>
            {
                _operationInProgress = isInProgress;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async void OnManualModeChanged(object? sender, bool isActive)
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(() =>
            {
                _manualModeActive = isActive;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async Task OnStartClickedAsync()
    {
        Logger.LogInformation(
            "StreamingControls.OnStartClicked — Status={Status} OpInProgress={OpInProgress} IsStartEnabled={IsStartEnabled}",
            _currentStatus, _operationInProgress, IsStartEnabled);

        if (_operationInProgress) return;

        var acquired = CoordinatorService.BeginOperation("Starting stream\u2026");
        if (!acquired)
        {
            Logger.LogWarning("StreamingControls.OnStartClicked — BeginOperation returned false");
            return;
        }

        try
        {
            var confirmed = await ConfirmDialogService.ConfirmAsync(
                "You are about to start a public live stream on YouTube.\n\n" +
                "Please confirm that you have obtained all necessary consents and approvals " +
                "to live stream this match, including from players, officials, and parents/guardians " +
                "of any minors involved.",
                "Start Live Stream");

            if (confirmed != true) return;

            _startCts?.Dispose();
            _startCts = new CancellationTokenSource();
            await StreamService.StartStreamAsync(_startCts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "StreamingControls.OnStartClicked — stream start failed");
            _currentStatus = LiveStreamStatus.Error;
            _errorMessage = ex.Message;
            StateHasChanged();
        }
        finally
        {
            CoordinatorService.MarkComplete();
        }
    }

    private async Task OnStopClickedAsync()
    {
        Logger.LogInformation(
            "StreamingControls.OnStopClicked — Status={Status} OpInProgress={OpInProgress}",
            _currentStatus, _operationInProgress);

        if (_operationInProgress) return;

        var acquired = false;
        try
        {
            acquired = CoordinatorService.BeginOperation("Stopping stream\u2026");
            if (!acquired) return;
            await StreamService.StopStreamAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _currentStatus = LiveStreamStatus.Error;
            _errorMessage = ex.Message;
            StateHasChanged();
        }
        finally
        {
            if (acquired) CoordinatorService.MarkComplete();
        }
    }

    private void OnCancelClicked()
    {
        _startCts?.Cancel();
    }

    private async Task OnDismissClickedAsync()
    {
        try
        {
            await StreamService.ResetAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _errorMessage = ex.Message;
        }
    }

    private string GetStatusText() => _currentStatus switch
    {
        LiveStreamStatus.Idle => "Idle",
        LiveStreamStatus.Starting => "Starting…",
        LiveStreamStatus.Live => "● Live",
        LiveStreamStatus.Stopping => "Stopping…",
        LiveStreamStatus.Error => "Error",
        _ => _currentStatus.ToString()
    };

    private string GetAvailabilityMessage() => _availability switch
    {
        YouTubeAvailability.AuthFailed => "YouTube authentication failed. Re-authorise via the tray icon → YouTube Setup.",
        YouTubeAvailability.ConfigError => "YouTube configuration error. Check LiveStreamId and credentials.",
        YouTubeAvailability.TransientError => "YouTube API temporarily unavailable. Streaming may recover on next attempt.",
        YouTubeAvailability.NotConfigured => "YouTube not configured. Run setup to authorise.",
        _ => string.Empty,
    };

    public void Dispose()
    {
        _disposed = true;
        StreamService.StatusChanged -= OnStatusChanged;
        StreamService.AuthStatusChanged -= OnAuthStatusChanged;
        CoordinatorService.OperationInProgressChanged -= OnOperationInProgressChanged;
        ManualModeService.ManualModeChanged -= OnManualModeChanged;
        _startCts?.Dispose();
    }
}
