@using PcsRemote.Core
@implements IAsyncDisposable
@inject IPlayCricketWatcherService WatcherService
@inject IJSRuntime JSRuntime

@* Renders nothing — handles browser push notification interop. *@

@code {
    private bool _disposed;
    private bool _permissionRequested;
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe before reading state to eliminate the enable-event race window.
        WatcherService.AutoWatchEnabledChanged += OnAutoWatchEnabledChanged;
        WatcherService.CountdownStarted += OnCountdownStarted;
        WatcherService.AutoCloseT60Warning += OnAutoCloseT60Warning;

        if (WatcherService.IsEnabled)
            await RequestPermissionOnceAsync();
    }

    private async void OnAutoWatchEnabledChanged(object? sender, AutoWatchEnabledChangedSnapshot e)
    {
        if (_disposed || !e.IsEnabled) return;
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                await RequestPermissionOnceAsync();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async void OnCountdownStarted(object? sender, CountdownStartedSnapshot e)
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                var module = await EnsureModuleAsync();
                await module.InvokeVoidAsync(
                    "sendNotification",
                    "Auto-close countdown",
                    $"Match will auto-close in {FormatDuration(e.InitialDuration)}");
            });
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private async void OnAutoCloseT60Warning(object? sender, EventArgs e)
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                var module = await EnsureModuleAsync();
                await module.InvokeVoidAsync(
                    "sendNotification",
                    "Auto-close warning",
                    "Match will auto-close in 60 seconds");
            });
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task RequestPermissionOnceAsync()
    {
        if (_permissionRequested) return;
        _permissionRequested = true;
        try
        {
            var module = await EnsureModuleAsync();
            await module.InvokeVoidAsync("requestPermission");
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task<IJSObjectReference> EnsureModuleAsync()
    {
        if (_module is null)
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/playCricketNotifications.js");
        return _module;
    }

    private static string FormatDuration(TimeSpan ts)
    {
        var totalSeconds = (int)ts.TotalSeconds;
        if (totalSeconds < 0) totalSeconds = 0;
        return $"{totalSeconds / 60:D2}:{totalSeconds % 60:D2}";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        WatcherService.AutoWatchEnabledChanged -= OnAutoWatchEnabledChanged;
        WatcherService.CountdownStarted -= OnCountdownStarted;
        WatcherService.AutoCloseT60Warning -= OnAutoCloseT60Warning;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            _module = null;
        }
    }
}
