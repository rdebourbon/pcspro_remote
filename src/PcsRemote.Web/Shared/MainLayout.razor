@inherits LayoutComponentBase

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-p-4">
            <img src="images/hhcc-logo.svg" alt="HHCC" class="hhcc-logo" />
            <RadzenText Text="PCS Remote" TextStyle="TextStyle.H5" Style="color: white;" />
            <ConnectedUserCount />
            <PcsProStatusIndicator />
        </RadzenStack>
        <ManualModeBanner />
        <OperationStatusBanner />
    </RadzenHeader>
    <RadzenBody>
        @Body
        <DebugSection />
    </RadzenBody>
</RadzenLayout>
<RadzenComponents />
