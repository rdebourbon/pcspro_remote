@page "/"
@using Microsoft.Extensions.Logging
@using PcsRemote.Core
@implements IDisposable
@inject IPcsProAutomationService AutomationService
@inject IManualModeService ManualModeService
@inject IOperationCoordinatorService CoordinatorService
@inject IYouTubeLiveStreamService StreamService
@inject ILogger<Index> Logger
@inject NotificationService NotificationService

<PageTitle>PCS Remote</PageTitle>

@if (_fetchInProgress || _currentState == PcsProState.MatchSelectionSearching)
{
    <div class="match-loading">Loading matches&hellip;</div>
}
else if (_currentState == PcsProState.MatchSelection || _currentState == PcsProState.MatchSelectionReady)
{
    @if (_matches is { Count: 0 })
    {
        <div class="match-empty-state">No matches available today</div>
    }
    else if (_matches is not null)
    {
        @foreach (var match in _matches)
        {
            <MatchCard Match="@match" IsInteractive="@(!_manualModeActive && !_operationInProgress)" DisabledTitle="@(_operationInProgress ? "Automation in progress\u2026" : "")" OnSelected="SelectMatchAsync" />
        }
    }
    else
    {
        <div class="load-matches-prompt">
            <p class="load-matches-prompt__text">PCS Pro is logged in and ready.</p>
            <button class="load-matches-button" disabled="@(_operationInProgress || _manualModeActive)" @onclick="FetchMatchesAsync">
                Load Today&rsquo;s Matches
            </button>
            <button class="use-current-match-button" disabled="@(_operationInProgress || _manualModeActive)" @onclick="UseCurrentMatchAsync">
                Use Current Match
            </button>
        </div>
    }
}

else if (_currentState == PcsProState.MatchLoaded)
{
    <div class="dashboard-grid">
        <div class="dashboard-panel dashboard-panel--match">
            @if (_loadedMatch is not null)
            {
                <div class="match-loaded">
                    <div class="match-loaded__teams">
                        <span class="match-loaded__home">@_loadedMatch.HomeTeam</span>
                        <span class="match-loaded__vs">vs</span>
                        <span class="match-loaded__away">@_loadedMatch.AwayTeam</span>
                    </div>
                    <ChangeMatchButton />
                </div>
            }
            else
            {
                <div class="match-loaded">
                    <div class="match-loaded__teams">
                        <span class="match-loaded__fallback">Match loaded</span>
                    </div>
                    <ChangeMatchButton />
                </div>
            }
            <ScoreboardPreview />
            <RefreshScoreboardButton />
        </div>
        <div class="dashboard-panel dashboard-panel--streaming">
            <StreamingControls />
        </div>
    </div>
}

else if (_currentState == PcsProState.Error)
{
    <ErrorDisplay />
}
else if (_currentState is PcsProState.NotRunning)
{
    <div class="not-running-prompt">
        <p class="not-running-prompt__text">PCS Pro is not running.</p>
        <button class="load-matches-button"
                disabled="@(_operationInProgress || _manualModeActive)"
                @onclick="RestartAutomationAsync">
            &#x27F3; Start Automation
        </button>
    </div>
}
else if (_currentState is PcsProState.Launching or PcsProState.LoginScreen)
{
    <div class="match-loading">Starting PCS Pro&hellip;</div>
}

@code {
    private PcsProState _currentState;
    private IReadOnlyList<MatchInfo>? _matches;
    private MatchInfo? _loadedMatch;
    private bool _fetchInProgress;
    private bool _manualModeActive;
    private bool _operationInProgress;

    protected override async Task OnInitializedAsync()
    {
        // R-3: Subscribe before reading CurrentState to close the race window
        // between snapshot capture and handler attachment.
        AutomationService.StateChanged += OnStateChanged;
        ManualModeService.ManualModeChanged += OnManualModeChanged;
        CoordinatorService.OperationInProgressChanged += OnOperationInProgressChanged;
        _currentState = AutomationService.CurrentState;
        _loadedMatch = AutomationService.LoadedMatch;
        _manualModeActive = ManualModeService.IsManualModeActive;
        _operationInProgress = CoordinatorService.IsOperationInProgress;

        Logger.LogInformation(
            "Index.OnInitializedAsync — State={State} ManualMode={ManualMode} OpInProgress={OpInProgress}",
            _currentState, _manualModeActive, _operationInProgress);

        if (_currentState == PcsProState.MatchSelectionReady)
            await FetchMatchesAsync();
    }

    private async void OnStateChanged(object? sender, PcsProState newState)
    {
        Logger.LogInformation(
            "Index.OnStateChanged — {OldState} → {NewState}, Matches={MatchCount}, LoadedMatch={HasLoadedMatch}",
            _currentState, newState, _matches?.Count, _loadedMatch is not null);

        try
        {
            // Dispatch ALL field access to the Blazor sync context to prevent
            // TOCTOU races between the background event thread and the renderer.
            await InvokeAsync(async () =>
            {
            _currentState = newState;

            if (newState == PcsProState.MatchLoaded)
            {
                // R2: Hydrate from singleton — assignment before StateHasChanged()
                // ensures the renderer sees team names in the same render pass.
                _loadedMatch = AutomationService.LoadedMatch;
                StateHasChanged();
            }
            else if (newState == PcsProState.MatchSelection)
            {
                // Clear stale cards so the "Load Matches" button appears on re-entry.
                _matches = null;
                _loadedMatch = null;
                StateHasChanged();
            }
            else if (newState == PcsProState.NotRunning)
            {
                // Clear all stale data when automation stops.
                _matches = null;
                _loadedMatch = null;
                StateHasChanged();
            }
            else if (newState == PcsProState.MatchSelectionReady)
            {
                // Brief intermediate state — LoadMatchAsync will immediately advance to MatchLoaded.
                StateHasChanged();
            }
            else
            {
                StateHasChanged();

                if (newState == PcsProState.Error)
                {
                    var streamStatus = StreamService.CurrentStatus;
                    if (streamStatus == LiveStreamStatus.Live || streamStatus == LiveStreamStatus.Starting)
                    {
                        try
                        {
                            await StreamService.StopStreamAsync();
                        }
                        catch (Exception ex) when (ex is not OperationCanceledException)
                        {
                            Logger.LogWarning(ex, "Failed to auto-stop stream on PCS Pro {State} entry", newState);
                        }
                    }
                }
            }
        });
        }
        catch (ObjectDisposedException) { }
    }

    private async Task FetchMatchesAsync()
    {
        Logger.LogInformation(
            "Index.FetchMatchesAsync — State={State} OpInProgress={OpInProgress}",
            _currentState, _operationInProgress);

        _fetchInProgress = true;
        _operationInProgress = true;
        _matches = null;
        StateHasChanged();

        try
        {
            var results = await AutomationService.GetTodaysMatchesAsync();
            _matches = results;
            Logger.LogInformation("Index.FetchMatchesAsync — got {MatchCount} matches", results.Count);

            // R-8: auto-select the only match so the user doesn't need to click when there is no choice.
            if ((_currentState == PcsProState.MatchSelection || _currentState == PcsProState.MatchSelectionReady)
                && _matches?.Count == 1)
            {
                var match = _matches[0];
                _loadedMatch = match;
                _matches = null; // Prevent re-trigger if OnStateChanged fires MatchSelection again
                Logger.LogInformation("Index.FetchMatchesAsync — auto-selecting single match {MatchId}", match.MatchId);
                await AutomationService.LoadMatchAsync(match);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Index.FetchMatchesAsync — failed");
        }
        finally
        {
            _fetchInProgress = false;
            _operationInProgress = CoordinatorService.IsOperationInProgress;
            StateHasChanged();
        }
    }

    private async Task SelectMatchAsync(MatchInfo match)
    {
        Logger.LogInformation(
            "Index.SelectMatchAsync — MatchId={MatchId} State={State} OpInProgress={OpInProgress}",
            match.MatchId, _currentState, _operationInProgress);

        if (_operationInProgress)
            return;

        if (ManualModeService.IsManualModeActive)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Automation is paused — disable manual mode before issuing commands");
            return;
        }

        // R-9: clear _matches before LoadMatchAsync so the intermediate
        // MatchSelectionReady event cannot flash stale cards.
        _loadedMatch = match;
        _matches = null;
        await AutomationService.LoadMatchAsync(match);
    }

    private async Task UseCurrentMatchAsync()
    {
        Logger.LogInformation(
            "Index.UseCurrentMatchAsync — State={State} OpInProgress={OpInProgress} ManualMode={ManualMode}",
            _currentState, _operationInProgress, _manualModeActive);

        if (_operationInProgress)
        {
            Logger.LogWarning("Index.UseCurrentMatchAsync — blocked by _operationInProgress");
            return;
        }

        if (ManualModeService.IsManualModeActive)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Automation is paused — disable manual mode before issuing commands");
            return;
        }

        _operationInProgress = true;
        StateHasChanged();

        try
        {
            var teams = await AutomationService.UseCurrentMatchAsync();
            _loadedMatch = AutomationService.LoadedMatch;
            Logger.LogInformation(
                "Index.UseCurrentMatchAsync — attached: Home={Home} Away={Away}",
                teams.Home.TeamName, teams.Away.TeamName);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Index.UseCurrentMatchAsync — failed");
            NotificationService.Notify(NotificationSeverity.Error, "Failed to attach to current match");
        }
        finally
        {
            _operationInProgress = CoordinatorService.IsOperationInProgress;
            StateHasChanged();
        }
    }

    private async void OnManualModeChanged(object? sender, bool isActive)
    {
        _manualModeActive = isActive;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private async Task RestartAutomationAsync()
    {
        Logger.LogInformation(
            "Index.RestartAutomationAsync — State={State} OpInProgress={OpInProgress}",
            _currentState, _operationInProgress);

        if (_operationInProgress)
            return;

        if (ManualModeService.IsManualModeActive)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Automation is paused — disable manual mode first");
            return;
        }

        bool acquired = false;
        try
        {
            acquired = CoordinatorService.BeginOperation("Starting automation\u2026");
            if (!acquired)
            {
                Logger.LogWarning("Index.RestartAutomationAsync — BeginOperation returned false");
                return;
            }
            await AutomationService.LaunchAndLoginAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Index.RestartAutomationAsync — failed");
            NotificationService.Notify(NotificationSeverity.Error, "Start automation failed");
        }
        finally
        {
            if (acquired)
                CoordinatorService.MarkComplete();
        }
    }

    private async void OnOperationInProgressChanged(object? sender, bool isInProgress)
    {
        _operationInProgress = isInProgress;
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        AutomationService.StateChanged -= OnStateChanged;
        ManualModeService.ManualModeChanged -= OnManualModeChanged;
        CoordinatorService.OperationInProgressChanged -= OnOperationInProgressChanged;
    }
}
