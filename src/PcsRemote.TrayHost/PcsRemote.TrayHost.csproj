<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\pcs-remote-normal.ico" />
    <EmbeddedResource Include="Resources\pcs-remote-manual.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcsRemote.Web\PcsRemote.Web.csproj" />
    <ProjectReference Include="..\PcsRemote.YouTube\PcsRemote.YouTube.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" GeneratePathProperty="true" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link Web appsettings so TrayHost and Web standalone bind to the same URLs -->
    <Content Include="..\PcsRemote.Web\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="Always" />
    <Content Include="..\PcsRemote.Web\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="Always" />
    <!-- Copy Web wwwroot so UseStaticFiles() can serve css/app.css from TrayHost's content root -->
    <Content Include="..\PcsRemote.Web\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Copy Radzen.Blazor static web assets so _content/ paths resolve in production.
         TrayHost uses Microsoft.NET.Sdk (not Web SDK) so NuGet static web assets
         are not automatically included in the publish output. -->
    <Content Include="$(PkgRadzen_Blazor)\staticwebassets\**\*"
             Link="wwwroot\_content\Radzen.Blazor\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PcsRemote.TrayHost.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>