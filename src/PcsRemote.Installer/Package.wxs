<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="PCS Remote"
           Manufacturer="High Halstow Cricket Club"
           Version="1.0.0.0"
           UpgradeCode="2DCBF298-D066-4428-A8C5-55337B615297"
           Scope="perMachine">

    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- ============================================================
         MSI Properties — wizard inputs with defaults
         ============================================================ -->

    <!-- INSTALLFOLDER is structurally under ProgramFilesFolder so WiX can
         auto-generate component GUIDs (WIX0231 requires a standard-directory
         ancestor). The Property override sets the actual default to
         C:\PcsRemote\ at install time. -->
    <Property Id="INSTALLFOLDER" Value="C:\PcsRemote\" Secure="yes" />

    <Property Id="PCSPRO_EXEPATH" Value="C:\Program Files (x86)\PCS Pro\cricket.exe" Secure="yes" />
    <Property Id="PCSPRO_PASSWORD" Hidden="yes" Secure="yes" />
    <Property Id="HTTP_PORT" Value="5000" Secure="yes" />
    <Property Id="YOUTUBE_CLIENTID" Secure="yes" />
    <Property Id="YOUTUBE_CLIENTSECRET" Hidden="yes" Secure="yes" />
    <Property Id="YOUTUBE_LIVESTREAMID" Secure="yes" />

    <!-- ============================================================
         Directory structure and file installation
         ============================================================ -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="PcsRemote">
        <Component Id="AppSettingsComponent" Guid="*" NeverOverwrite="yes">
          <File Id="AppSettingsJson"
                Source="..\..\publish\appsettings.json"
                KeyPath="yes" />
        </Component>
        <Component Id="WriteConfigScriptComponent" Guid="*">
          <File Id="WriteConfigPs1"
                Source="WriteConfig.ps1"
                KeyPath="yes" />
        </Component>
        <Component Id="ConfigTransportComponent" Guid="*">
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="InstallFolder" Value="[INSTALLFOLDER]"
                         Type="string" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="ExePath" Value="[PCSPRO_EXEPATH]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="Port" Value="[HTTP_PORT]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="ClientId" Value="[YOUTUBE_CLIENTID]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="ClientSecret" Value="[YOUTUBE_CLIENTSECRET]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="LiveStreamId" Value="[YOUTUBE_LIVESTREAMID]" Type="string" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="PCS Remote" Level="1">
      <ComponentRef Id="AppSettingsComponent" />
      <ComponentRef Id="WriteConfigScriptComponent" />
      <ComponentRef Id="ConfigTransportComponent" />
      <ComponentGroupRef Id="PublishOutput" />
    </Feature>

    <!-- ============================================================
         Wizard UI — WixUI_InstallDir with custom dialog panels
         Navigation: Welcome → License → InstallDir → PcsProSettings
                     → YouTubeSettings → VerifyReady → Install
         ============================================================ -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <UI>
      <!-- Override InstallDirDlg Next → go to PcsProSettingsDlg -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog"
               Value="PcsProSettingsDlg" Order="5"
               Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />

      <!-- PcsProSettingsDlg navigation -->
      <Publish Dialog="PcsProSettingsDlg" Control="Back" Event="NewDialog"
               Value="InstallDirDlg" />
      <Publish Dialog="PcsProSettingsDlg" Control="Next" Event="NewDialog"
               Value="YouTubeSettingsDlg" />

      <!-- YouTubeSettingsDlg navigation -->
      <Publish Dialog="YouTubeSettingsDlg" Control="Back" Event="NewDialog"
               Value="PcsProSettingsDlg" />
      <Publish Dialog="YouTubeSettingsDlg" Control="Next" Event="NewDialog"
               Value="VerifyReadyDlg" />

      <!-- Override VerifyReadyDlg Back → go to YouTubeSettingsDlg -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="YouTubeSettingsDlg" Order="5"
               Condition="NOT Installed" />
    </UI>

    <!-- ============================================================
         Configuration Write CA (S-004)
         Writes wizard-collected values into appsettings.json on
         fresh install only. Skipped on upgrade/repair.
         Values are transported via registry (ConfigTransportComponent)
         to eliminate command-line quoting/injection risks.
         ============================================================ -->

    <!-- Step 1: Immediate CA sets the deferred CA's command line.
         Only INSTALLFOLDER is in the command (directory path — safe).
         All wizard values are read from registry by the script. -->
    <CustomAction Id="CA_SetWriteConfigData"
                  Property="CA_WriteConfigExec"
                  Value='powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLFOLDER]WriteConfig.ps1"'
                  HideTarget="yes" />

    <!-- Step 2: Deferred CA executes PowerShell via WixQuietExec (32-bit).
         Uses WixQuietExec (not WixQuietExec64) so that the 32-bit PowerShell
         process reads the same WOW6432Node registry view where the 32-bit MSI
         wrote the transport values via WriteRegistryValues. -->
    <CustomAction Id="CA_WriteConfigExec"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes" />

    <InstallExecuteSequence>
      <Custom Action="CA_SetWriteConfigData" Before="CA_WriteConfigExec"
              Condition="NOT Installed" />
      <Custom Action="CA_WriteConfigExec" After="WriteRegistryValues"
              Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Package>

</Wix>
