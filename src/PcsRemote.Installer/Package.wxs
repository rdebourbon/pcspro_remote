<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="PCS Remote"
           Manufacturer="High Halstow Cricket Club"
           Version="$(var.ProductVersion)"
           UpgradeCode="2DCBF298-D066-4428-A8C5-55337B615297"
           Scope="perMachine">

    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="PcsRemote.ico" SourceFile="..\PcsRemote.TrayHost\Resources\pcs-remote-normal.ico" />
    <Property Id="ARPPRODUCTICON" Value="PcsRemote.ico" />

    <!-- ============================================================
         MSI Properties — wizard inputs with defaults
         ============================================================ -->

    <!-- INSTALLFOLDER is structurally under ProgramFilesFolder so WiX can
         auto-generate component GUIDs (WIX0231 requires a standard-directory
         ancestor). The Property override sets the actual default to
         C:\PcsRemote\ at install time. On upgrade, the RegistrySearch detects
         the previous install directory from the registry transport (32-bit
         view, consistent with WriteRegistryValues). -->
    <Property Id="INSTALLFOLDER" Value="C:\PcsRemote\" Secure="yes">
      <!-- On upgrade, detect previous install dir from registry transport.
           Type="raw" preferred over "directory" — returns the stored path even
           if the directory was removed, so the upgrade reinstalls to the
           originally chosen location. 32-bit registry view is implicit (x86
           package) — consistent with WriteRegistryValues in S-004/S-005.
           Key path must match ConfigTransportComponent's InstallFolder value
           (see RegistryValue elements below). -->
      <RegistrySearch Id="PrevInstallDir" Root="HKLM"
                      Key="SOFTWARE\PcsRemote\Install" Name="InstallFolder"
                      Type="raw" Bitness="always32" />
    </Property>

    <Property Id="PCSPRO_EXEPATH" Value="C:\Program Files (x86)\PCS Pro\cricket.exe" Secure="yes">
      <RegistrySearch Id="PrevExePath" Root="HKLM"
                      Key="SOFTWARE\PcsRemote\Install" Name="ExePath"
                      Type="raw" Bitness="always32" />
    </Property>
    <Property Id="PCSPRO_PASSWORD" Hidden="yes" Secure="yes">
      <RegistrySearch Id="PrevPassword" Root="HKLM"
                      Key="SOFTWARE\PcsRemote\Install" Name="Password"
                      Type="raw" Bitness="always32" />
    </Property>
    <Property Id="HTTP_PORT" Value="5000" Secure="yes">
      <RegistrySearch Id="PrevPort" Root="HKLM"
                      Key="SOFTWARE\PcsRemote\Install" Name="Port"
                      Type="raw" Bitness="always32" />
    </Property>
    <Property Id="YOUTUBE_CLIENTID" Secure="yes">
      <RegistrySearch Id="PrevClientId" Root="HKLM"
                      Key="SOFTWARE\PcsRemote\Install" Name="ClientId"
                      Type="raw" Bitness="always32" />
    </Property>
    <Property Id="YOUTUBE_CLIENTSECRET" Hidden="yes" Secure="yes">
      <RegistrySearch Id="PrevClientSecret" Root="HKLM"
                      Key="SOFTWARE\PcsRemote\Install" Name="ClientSecret"
                      Type="raw" Bitness="always32" />
    </Property>
    <Property Id="YOUTUBE_LIVESTREAMID" Secure="yes">
      <RegistrySearch Id="PrevLiveStreamId" Root="HKLM"
                      Key="SOFTWARE\PcsRemote\Install" Name="LiveStreamId"
                      Type="raw" Bitness="always32" />
    </Property>

    <!-- ============================================================
         Directory structure and file installation
         ============================================================ -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="PcsRemote">
        <Component Id="AppSettingsComponent" Guid="*" NeverOverwrite="yes">
          <File Id="AppSettingsJson"
                Source="..\..\publish\appsettings.json"
                KeyPath="yes" />
        </Component>
        <Component Id="WriteConfigScriptComponent" Guid="*">
          <File Id="WriteConfigPs1"
                Source="WriteConfig.ps1"
                KeyPath="yes" />
        </Component>
        <Component Id="InstallTaskSchedulerScriptComponent" Guid="*">
          <File Id="InstallTaskSchedulerPs1"
                Source="InstallTaskScheduler.ps1"
                KeyPath="yes" />
        </Component>
        <Component Id="UninstallTaskSchedulerScriptComponent" Guid="*">
          <File Id="UninstallTaskSchedulerPs1"
                Source="UninstallTaskScheduler.ps1"
                KeyPath="yes" />
        </Component>
        <Component Id="InstallFirewallScriptComponent" Guid="*">
          <File Id="InstallFirewallPs1"
                Source="InstallFirewall.ps1"
                KeyPath="yes" />
        </Component>
        <Component Id="UninstallFirewallScriptComponent" Guid="*">
          <File Id="UninstallFirewallPs1"
                Source="UninstallFirewall.ps1"
                KeyPath="yes" />
        </Component>
        <Component Id="InstallEnvVarScriptComponent" Guid="*">
          <File Id="InstallEnvVarPs1"
                Source="InstallEnvVar.ps1"
                KeyPath="yes" />
        </Component>
        <Component Id="ConfigTransportComponent" Guid="*" Permanent="yes">
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="InstallFolder" Value="[INSTALLFOLDER]"
                         Type="string" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="ExePath" Value="[PCSPRO_EXEPATH]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="Port" Value="[HTTP_PORT]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="ClientId" Value="[YOUTUBE_CLIENTID]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="ClientSecret" Value="[YOUTUBE_CLIENTSECRET]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="LiveStreamId" Value="[YOUTUBE_LIVESTREAMID]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="Password" Value="[PCSPRO_PASSWORD]" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\PcsRemote\Install"
                         Name="LogonUser" Value="[%USERDOMAIN]\[LogonUser]" Type="string" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="PCS Remote" Level="1">
      <ComponentRef Id="AppSettingsComponent" />
      <ComponentRef Id="WriteConfigScriptComponent" />
      <ComponentRef Id="InstallTaskSchedulerScriptComponent" />
      <ComponentRef Id="UninstallTaskSchedulerScriptComponent" />
      <ComponentRef Id="InstallFirewallScriptComponent" />
      <ComponentRef Id="UninstallFirewallScriptComponent" />
      <ComponentRef Id="InstallEnvVarScriptComponent" />
      <ComponentRef Id="ConfigTransportComponent" />
      <ComponentGroupRef Id="PublishOutput" />
    </Feature>

    <!-- ============================================================
         Wizard UI — WixUI_InstallDir with custom dialog panels
         Navigation: Welcome → License → InstallDir → PcsProSettings
                     → YouTubeSettings → VerifyReady → Install
         ============================================================ -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <UI>
      <!-- Override InstallDirDlg Next → go to PcsProSettingsDlg -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog"
               Value="PcsProSettingsDlg" Order="5"
               Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />

      <!-- PcsProSettingsDlg navigation -->
      <Publish Dialog="PcsProSettingsDlg" Control="Back" Event="NewDialog"
               Value="InstallDirDlg" />
      <Publish Dialog="PcsProSettingsDlg" Control="Next" Event="NewDialog"
               Value="YouTubeSettingsDlg" />

      <!-- YouTubeSettingsDlg navigation -->
      <Publish Dialog="YouTubeSettingsDlg" Control="Back" Event="NewDialog"
               Value="PcsProSettingsDlg" />
      <Publish Dialog="YouTubeSettingsDlg" Control="Next" Event="NewDialog"
               Value="VerifyReadyDlg" />

      <!-- Override VerifyReadyDlg Back → go to YouTubeSettingsDlg -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="YouTubeSettingsDlg" Order="5"
               Condition="NOT Installed" />
    </UI>

    <!-- ============================================================
         Configuration Write CA (S-004)
         Writes wizard-collected values into appsettings.json on
         fresh install only. Skipped on upgrade/repair.
         Values are transported via registry (ConfigTransportComponent)
         to eliminate command-line quoting/injection risks.
         ============================================================ -->

    <!-- Step 1: Immediate CA sets the deferred CA's command line.
         Only INSTALLFOLDER is in the command (directory path — safe).
         All wizard values are read from registry by the script. -->
    <CustomAction Id="CA_SetWriteConfigData"
                  Property="CA_WriteConfigExec"
                  Value='&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLFOLDER]WriteConfig.ps1"'
                  HideTarget="yes" />

    <!-- Step 2: Deferred CA executes PowerShell via WixQuietExec (32-bit).
         Uses WixQuietExec (not WixQuietExec64) so that the 32-bit PowerShell
         process reads the same WOW6432Node registry view where the 32-bit MSI
         wrote the transport values via WriteRegistryValues. -->
    <CustomAction Id="CA_WriteConfigExec"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes" />

    <!-- ============================================================
         System Artifact CAs (S-005)
         Task Scheduler, Firewall, and Environment Variable CAs.
         All follow the same WixQuietExec + registry transport pattern.
         Install CAs run on fresh install; uninstall CAs run on removal.
         ============================================================ -->

    <!-- Task Scheduler — Install -->
    <CustomAction Id="CA_SetInstallTaskSchedulerData"
                  Property="CA_InstallTaskSchedulerExec"
                  Value='&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLFOLDER]InstallTaskScheduler.ps1"'
                  HideTarget="yes" />
    <CustomAction Id="CA_InstallTaskSchedulerExec"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes" />

    <!-- Task Scheduler — Uninstall -->
    <CustomAction Id="CA_SetUninstallTaskSchedulerData"
                  Property="CA_UninstallTaskSchedulerExec"
                  Value='&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLFOLDER]UninstallTaskScheduler.ps1"'
                  HideTarget="yes" />
    <CustomAction Id="CA_UninstallTaskSchedulerExec"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes" />

    <!-- Firewall — Install -->
    <CustomAction Id="CA_SetInstallFirewallData"
                  Property="CA_InstallFirewallExec"
                  Value='&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLFOLDER]InstallFirewall.ps1"'
                  HideTarget="yes" />
    <CustomAction Id="CA_InstallFirewallExec"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes" />

    <!-- Firewall — Uninstall -->
    <CustomAction Id="CA_SetUninstallFirewallData"
                  Property="CA_UninstallFirewallExec"
                  Value='&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLFOLDER]UninstallFirewall.ps1"'
                  HideTarget="yes" />
    <CustomAction Id="CA_UninstallFirewallExec"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes" />

    <!-- Environment Variable — Install (no uninstall counterpart per HLPS item 8) -->
    <CustomAction Id="CA_SetInstallEnvVarData"
                  Property="CA_InstallEnvVarExec"
                  Value='&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLFOLDER]InstallEnvVar.ps1"'
                  HideTarget="yes" />
    <CustomAction Id="CA_InstallEnvVarExec"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_X86"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes" />

    <InstallExecuteSequence>
      <!-- S-004: Config write on fresh install only (not upgrade).
           On upgrade, existing appsettings.json is preserved by NeverOverwrite
           + this CA skip. New config keys in future versions are handled by
           .NET configuration layering (code defaults — HLPS-014 scope item 7). -->
      <Custom Action="CA_SetWriteConfigData" Before="CA_WriteConfigExec"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="CA_WriteConfigExec" After="WriteRegistryValues"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />

      <!-- S-005: System artifact install CAs — chained after config write -->
      <Custom Action="CA_SetInstallTaskSchedulerData" Before="CA_InstallTaskSchedulerExec"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="CA_InstallTaskSchedulerExec" After="CA_WriteConfigExec"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />

      <Custom Action="CA_SetInstallFirewallData" Before="CA_InstallFirewallExec"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="CA_InstallFirewallExec" After="CA_InstallTaskSchedulerExec"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />

      <Custom Action="CA_SetInstallEnvVarData" Before="CA_InstallEnvVarExec"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="CA_InstallEnvVarExec" After="CA_InstallFirewallExec"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />

      <!-- S-005: System artifact uninstall CAs — standalone uninstall only (not upgrade) -->
      <Custom Action="CA_SetUninstallFirewallData" Before="CA_UninstallFirewallExec"
              Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="CA_UninstallFirewallExec" Before="CA_UninstallTaskSchedulerExec"
              Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />

      <Custom Action="CA_SetUninstallTaskSchedulerData" Before="CA_UninstallTaskSchedulerExec"
              Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="CA_UninstallTaskSchedulerExec" Before="RemoveFiles"
              Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
    </InstallExecuteSequence>

  </Package>

</Wix>
